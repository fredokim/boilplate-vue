{
  "name": "boilplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate-theme-scss": "tsx scripts/generate-theme-scss.ts",
    "tokens:build": "tsx scripts/build-tokens.ts && npm run generate-theme-scss",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "generate": "tsx scripts/generate.ts",
    "generate:contract": "tsx scripts/generate-contract.ts",
    "generate:form": "tsx scripts/generate-form.ts",
    "generate:layout": "tsx scripts/generate-layout.ts",
    "generate:page": "tsx scripts/generate-page.ts",
    "generate:component": "tsx scripts/generate-component.ts",
    "generate:api": "tsx scripts/generate-api.ts",
    "generate:feature": "tsx scripts/generate-feature.ts",
    "predev": "npm run generate-theme-scss && npm run lint && npm run typecheck",
    "dev": "vite",
    "dev:server-mode": "cross-env VITE_DATA_MODE=server npm run dev",
    "prestorybook": "npm run generate-theme-scss && npm run lint && npm run typecheck",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "check:contract": "vitest run src/test/contract",
    "contract:sync": "tsx scripts/sync-contract.ts",
    "e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install chromium",
    "perf:api:k6": "k6 run tests/performance/api-smoke.k6.js",
    "perf:bundle": "cross-env ANALYZE=true npm run build",
    "preperf:lighthouse": "cross-env VITE_DATA_MODE=server npm run build",
    "perf:lighthouse": "npx -y @lhci/cli@0.15.1 autorun --config=./lighthouserc.cjs",
    "perf:memory": "playwright test tests/performance/memory-smoke.spec.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:automation": "tsx scripts/check-automation.ts",
    "check:generators": "tsx scripts/check-generators.ts",
    "check:bundle": "tsx scripts/check-bundle-budget.ts",
    "check:deps": "tsx scripts/check-dependency-size.ts",
    "check:ci": "npm run check:tokens && npm run check:docs && npm run check:env && npm run generate-theme-scss && npm run lint && npm run typecheck && npm run test && npm run check:contract && npm run check:automation && npm run check:generators && npm run check:deps && npm run build && npm run check:bundle && npm run build-storybook",
    "lint": "eslint \"{src,scripts,.storybook}/**/*.{js,ts,vue}\" --max-warnings=0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:env": "tsx scripts/check-env-example.ts",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/vue-virtual": "^3.13.36",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^13.2.0",
    "axios": "^1.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "grid-layout-plus": "^1.1.1",
    "hls.js": "^1.7.1",
    "mitt": "^3.0.1",
    "pinia": "^3.0.2",
    "reflect-metadata": "^0.2.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "web-vitals": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.11.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.2.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.89.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^3.4.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vite-plugin-emit-metadata": "^0.2.0",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^2.2.8"
  },
  "engines": {
    "node": ">=22"
  }
}
